---
import '../styles/global.css';
import hankenUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { company, indexable } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Transparenter Header über einem Vollbild-Hero */
  overlayHeader?: boolean;
  /** Intro-Vorhang beim ersten Besuch pro Sitzung (nur Startseite) */
  intro?: boolean;
  ogImage?: string;
}

const { title, description, overlayHeader = false, intro = false, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(company.name) ? title : `${title} · ${company.name}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#1f3a40" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={hankenUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}

    <script is:inline define:vars={{ intro }}>
      (function (d) {
        d.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        try {
          if (intro && !sessionStorage.getItem('gerhardt-intro') && !location.hash) d.classList.add('intro');
        } catch (e) {}
      })(document.documentElement);
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-svh">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-ink-900 focus:px-4 focus:py-3 focus:text-stone-50">
      Zum Inhalt springen
    </a>
    <Header overlay={overlayHeader} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <StickyCta />

    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
    </script>
  </body>
</html>
