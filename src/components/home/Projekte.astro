---
import { getEntry } from 'astro:content';
import ProjectCard from '../ProjectCard.astro';
import SectionIntro from '../SectionIntro.astro';

const [bergparadies, naturstein, provence] = await Promise.all([
  getEntry('projekte', 'bergparadies'),
  getEntry('projekte', 'naturstein'),
  getEntry('projekte', 'provence'),
]);
if (!bergparadies || !naturstein || !provence) throw new Error('Projekt für die Startseite fehlt');
---

<section id="projekte" class="section pt-0" aria-labelledby="projekte-title">
  <div class="container-page">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <SectionIntro titleId="projekte-title" label="Ausgewählte Projekte" title="Drei Gärten, drei Ausgangslagen." />
      <a href="/projekte" class="link-underline shrink-0 text-small" data-reveal>Alle Projekte</a>
    </div>

    <div class="mt-14 grid gap-y-14 md:mt-20 md:grid-cols-12 md:gap-x-6">
      <div class="md:col-span-7">
        <ProjectCard project={bergparadies} sizes="(min-width: 1440px) 790px, (min-width: 768px) 56vw, 100vw" />
      </div>
      <div class="grid content-start gap-y-14 md:col-span-4 md:col-start-9 md:pt-32">
        <ProjectCard project={naturstein} sizes="(min-width: 1440px) 450px, (min-width: 768px) 32vw, 100vw" delay={120} />
        <ProjectCard project={provence} ratio="3/2" sizes="(min-width: 1440px) 450px, (min-width: 768px) 32vw, 100vw" delay={120} />
      </div>
    </div>
  </div>
</section>
