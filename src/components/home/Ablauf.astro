---
import Photo from '../Photo.astro';
import SectionIntro from '../SectionIntro.astro';
import Placeholder from '../Placeholder.astro';
import bodenplatte from '../../assets/images/ablauf/bodenplatte-poolbau-bad-camberg.jpg';
import kran from '../../assets/images/ablauf/poolbecken-anlieferung-kran.webp';
import monteur from '../../assets/images/ablauf/monteur-gerhardt-baugrube-daemmung.webp';

const photos = [
  { img: bodenplatte, alt: 'Zwei Arbeiter ziehen den Beton der Bodenplatte in einer mit Folie ausgelegten Poolbaugrube ab', caption: 'Bodenplatte, Bad Camberg', position: '50% 50%' },
  { img: kran, alt: 'Ein Poolbecken schwebt am Kran über der Baugrube eines Gartens', caption: 'Anlieferung des Beckens per Kran', position: '50% 40%' },
  { img: monteur, alt: 'Monteur der Gerhardt GmbH an der Baugrubenwand, daneben die Dämmplatten für das Becken', caption: 'Dämmung am Beckenrand', position: '40% 50%' },
];

const steps = [
  { title: 'Erstgespräch vor Ort', text: 'Wir sehen uns Haus, Garten und Gelände an. Wie soll der Pool genutzt werden, was ist schon da, was ist geplant?' },
  { title: 'Entwurf und Visualisierung', todo: 'prüfen: 3D?', text: 'Aus dem Gespräch entsteht ein Entwurf: Lage, Maß, Beckenart, Material und Technik.' },
  { title: 'Angebot', todo: 'prüfen: Festpreis?', text: 'Sie erhalten ein Angebot mit allen Leistungen, bevor gebaut wird.' },
  { title: 'Bau mit festem Zeitplan', text: 'Den Zeitplan legen wir gemeinsam fest. Im Bestand dauert der Bau einige Wochen, eine Neuanlage mehrere Monate.' },
  { title: 'Übergabe und Service', text: 'Nach der Übergabe bleiben wir: Frühjahrs-Check, Einwinterung und laufende Pflege auf Wunsch.' },
];
---

<section id="ablauf" class="section bg-water-800 text-stone-50" aria-labelledby="ablauf-title">
  <div class="container-page">
    <SectionIntro titleId="ablauf-title" label="Ablauf" title="In fünf Schritten zum fertigen Pool." dark>
      <p>Ein Team plant und baut, die eigene Bauleitung koordiniert. Sie haben von der ersten Begehung bis zur Wartung einen Ansprechpartner.</p>
    </SectionIntro>

    <div class="mt-14 grid grid-cols-3 gap-3 md:mt-20 md:gap-6">
      {photos.map((p, i) => (
        <figure data-reveal="image" style={`--reveal-delay: ${i * 120}ms`}>
          <div class="aspect-[4/5] overflow-hidden bg-ink-900">
            <Photo
              src={p.img}
              alt={p.alt}
              widths={[320, 480, 768, 1080]}
              sizes="(min-width: 1440px) 430px, 31vw"
              class="h-full w-full object-cover"
              style={`object-position: ${p.position}`}
            />
          </div>
          <figcaption class="mt-3 text-[0.8125rem] leading-snug text-water-200">{p.caption}</figcaption>
        </figure>
      ))}
    </div>

    <ol class="mt-16 grid gap-y-0 md:mt-24 md:grid-cols-5 md:gap-x-6">
      {steps.map((s, i) => (
        <li class="border-t border-stone-50/20 py-6 md:py-8" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <span class="font-display text-[2.5rem] leading-none font-[300] text-sand-500">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-5 font-sans text-[1.0625rem] font-semibold tracking-normal">{s.title}</h3>
          {s.todo && <p class="mt-2"><Placeholder name={s.todo} /></p>}
          <p class="mt-3 text-small text-water-200">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
