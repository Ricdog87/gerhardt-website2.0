---
import Photo from '../Photo.astro';
import Placeholder from '../Placeholder.astro';
import ausgangslage from '../../assets/images/ablauf/ausgangslage-folienbecken-naturstein.webp';
import entwurf from '../../assets/images/ablauf/gartenplanung-entwurf-bildschirm.jpg';
import luftbild from '../../assets/images/ablauf/luftbild-poolbecken-kran-garten.webp';
import kran from '../../assets/images/ablauf/poolbecken-anlieferung-kran.webp';
import monteur from '../../assets/images/ablauf/monteur-gerhardt-baugrube-daemmung.webp';
import uebergabe from '../../assets/images/ablauf/uebergabe-pool-bergparadies-lounge.webp';

type Shot = { img: ImageMetadata; alt: string; caption: string; position?: string; area?: string };
type Step = { title: string; todo?: string; text: string; shots: Shot[] };

const steps: Step[] = [
  {
    title: 'Erstgespräch vor Ort',
    text: 'Wir sehen uns Haus, Garten und Gelände an. Wie soll der Pool genutzt werden, was ist schon da, was ist geplant?',
    shots: [{ img: ausgangslage, alt: 'Altes Folienbecken mit Abdeckplane in einem winterlichen Garten vor einer Natursteinmauer', caption: 'Ausgangslage im Projekt Naturstein: ein altes Folienbecken', position: '50% 60%' }],
  },
  {
    title: 'Entwurf und Visualisierung',
    todo: 'prüfen: 3D?',
    text: 'Aus dem Gespräch entsteht ein Entwurf: Lage, Maß, Beckenart, Material und Technik.',
    shots: [{ img: entwurf, alt: 'Entwurfsplan eines Gartens am Bildschirm', caption: 'Entwurf am Bildschirm', position: '35% 50%' }],
  },
  {
    title: 'Angebot',
    todo: 'prüfen: Festpreis?',
    text: 'Sie erhalten ein Angebot mit allen Leistungen, bevor gebaut wird.',
    shots: [],
  },
  {
    title: 'Bau mit festem Zeitplan',
    text: 'Den Zeitplan legen wir gemeinsam fest. Im Bestand dauert der Bau einige Wochen, eine Neuanlage mehrere Monate.',
    shots: [
      { img: luftbild, alt: 'Luftbild: Ein Poolbecken hängt am Kran über der Baugrube neben einem Wohnhaus', caption: 'Anlieferung von oben', area: 'big' },
      { img: kran, alt: 'Ein Poolbecken schwebt am Kran über der Baugrube eines Gartens', caption: 'Das Becken kommt per Kran', position: '50% 40%' },
      { img: monteur, alt: 'Monteur der Gerhardt GmbH an der Baugrubenwand, daneben die Dämmplatten für das Becken', caption: 'Eigenes Team auf der Baustelle', position: '40% 50%' },
    ],
  },
  {
    title: 'Übergabe und Service',
    text: 'Nach der Übergabe bleiben wir: Frühjahrs-Check, Einwinterung und laufende Pflege auf Wunsch.',
    shots: [{ img: uebergabe, alt: 'Fertiger Pool mit hellem Plattenbelag und Lounge-Möbeln unter einem Sonnenschirm, Projekt Bergparadies', caption: 'Übergabe: Projekt Bergparadies', position: '50% 60%' }],
  },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="ablauf" class="ablauf grain relative overflow-hidden bg-water-800 text-stone-50" data-scene="dark" aria-labelledby="ablauf-title">
  <div class="ablauf-pin" data-ablauf-pin>
    <div class="ablauf-track flex flex-col gap-20 py-(--section)" data-ablauf-track>
      <header class="ablauf-intro container-page shrink-0">
        <p class="label text-sand-500" data-reveal>Ablauf</p>
        <h2 id="ablauf-title" class="mt-5 text-display" data-split>In fünf Schritten zum fertigen Pool.</h2>
        <p class="mt-7 max-w-[40ch] text-water-200" data-reveal>
          Ein Team plant und baut, die eigene Bauleitung koordiniert. Sie haben von der ersten Begehung bis zur Wartung einen
          Ansprechpartner.
        </p>
        <p class="ablauf-hint label mt-12 hidden items-center gap-4 text-stone-50/70" aria-hidden="true">
          Weiter scrollen <span class="block h-px w-16 bg-stone-50/50"></span>
        </p>
      </header>

      {steps.map((s, i) => (
        <article class="ablauf-step container-page grid shrink-0 gap-8 lg:grid-cols-[1.35fr_1fr] lg:items-end lg:gap-12" data-step>
          {s.shots.length === 0 ? (
            <div class="ablauf-media relative flex h-[44vh] items-center justify-center border border-stone-50/20" aria-hidden="true">
              <span class="font-display text-[clamp(8rem,4rem+14vw,18rem)] leading-none font-[200] text-transparent [-webkit-text-stroke:1px_rgb(246_243_238/0.45)]">{pad(i + 1)}</span>
            </div>
          ) : (
            <div class:list={['ablauf-media relative h-[52vh]', s.shots.length > 1 && 'grid grid-cols-2 grid-rows-2 gap-3']}>
              {s.shots.map((shot) => (
                <figure class:list={['relative overflow-hidden bg-ink-950', s.shots.length === 1 && 'h-full', shot.area === 'big' && 'row-span-2']}>
                  <Photo
                    src={shot.img}
                    alt={shot.alt}
                    widths={[480, 768, 1080, 1440]}
                    sizes={s.shots.length > 1 ? '(min-width: 1024px) 26vw, 50vw' : '(min-width: 1024px) 40vw, 100vw'}
                    class="strip-img absolute inset-0 h-full w-full scale-[1.15] object-cover"
                    style={`object-position: ${shot.position ?? '50% 50%'}`}
                    data-strip-img
                  />
                  <figcaption class="absolute inset-x-0 bottom-0 bg-[rgb(9_17_19/0.55)] px-3 py-2 text-[0.75rem] leading-snug text-stone-50/90">
                    {shot.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
          <div class="lg:pb-2">
            <span class="font-display text-[3.5rem] leading-none font-[250] text-sand-500 lg:text-[5rem]">{pad(i + 1)}</span>
            <h3 class="mt-6 text-title">{s.title}</h3>
            {s.todo && <p class="mt-3"><Placeholder name={s.todo} /></p>}
            <p class="mt-4 max-w-[34ch] text-water-200">{s.text}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="ablauf-progress container-page mt-12 hidden" aria-hidden="true">
      <div class="relative h-px bg-stone-50/20">
        <div class="absolute inset-0 origin-left scale-x-0 bg-sand-500" data-ablauf-progress></div>
      </div>
      <ol class="mt-4 grid grid-cols-5 text-[0.75rem] tracking-wide text-stone-50/60">
        {steps.map((s, i) => <li>{pad(i + 1)} {s.title}</li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  /* Querformat als Filmstreifen nur auf großen Screens mit aktiver Bewegung. Sonst stehen die Schritte untereinander. */
  @media (min-width: 64rem) {
    .ablauf-step { max-width: 90rem; }
    :global(.motion) .ablauf-pin { display: flex; height: 100svh; flex-direction: column; justify-content: center; }
    :global(.motion) .ablauf-track {
      width: max-content;
      flex-direction: row;
      align-items: center;
      gap: 6vw;
      padding: 0 12vw 0 var(--gutter);
    }
    :global(.motion) .ablauf-intro { width: 30vw; padding-inline: 0; }
    :global(.motion) .ablauf-hint { display: flex; }
    :global(.motion) .ablauf-step { width: min(66vw, 68rem); height: 68vh; padding-inline: 0; }
    :global(.motion) .ablauf-media { height: 100%; }
    :global(.motion) .ablauf-progress { display: block; }
  }
</style>

<script>
  import { gsap, reduced, startMotion } from '../../scripts/motion';

  startMotion();

  if (!reduced) {
    const mm = gsap.matchMedia();
    mm.add('(min-width: 64rem)', () => {
      const section = document.getElementById('ablauf')!;
      const track = section.querySelector<HTMLElement>('[data-ablauf-track]')!;
      const progress = section.querySelector<HTMLElement>('[data-ablauf-progress]');
      const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          pin: true,
          start: 'top top',
          end: () => `+=${distance()}`,
          scrub: 0.9,
          invalidateOnRefresh: true,
          // Pin zuerst vermessen, damit alle späteren Trigger den Pin-Abstand kennen
          refreshPriority: 1,
        },
      });
      tl.to(track, { x: () => -distance(), ease: 'none' }, 0);
      if (progress) tl.to(progress, { scaleX: 1, ease: 'none' }, 0);

      // Bilder bewegen sich langsamer als der Streifen: Tiefe wie bei einer Kamerafahrt
      section.querySelectorAll<HTMLElement>('[data-strip-img]').forEach((img) => {
        gsap.fromTo(
          img,
          { xPercent: 7 },
          {
            xPercent: -7,
            ease: 'none',
            scrollTrigger: { trigger: img.closest('figure'), containerAnimation: tl, start: 'left right', end: 'right left', scrub: true },
          },
        );
      });
    });
  }
</script>
