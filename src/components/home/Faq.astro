---
import { getCollection } from 'astro:content';
import SectionIntro from '../SectionIntro.astro';
import Placeholder from '../Placeholder.astro';

const items = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

// Nur beantwortete Fragen ins FAQPage-Schema, Platzhalter nie
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items
    .filter((i) => !i.data.platzhalter)
    .map((i) => ({ '@type': 'Question', name: i.data.frage, acceptedAnswer: { '@type': 'Answer', text: i.data.antwort } })),
};
---

<section class="section" aria-labelledby="faq-title">
  <div class="container-page grid gap-y-12 md:grid-cols-12 md:gap-x-6">
    <div class="md:col-span-4">
      <SectionIntro titleId="faq-title" label="Häufige Fragen" title="Was Bauherren uns fragen." />
    </div>

    <div class="md:col-span-7 md:col-start-6">
      {items.map((item, i) => (
        <details class="faq group border-t border-stone-200 last:border-b" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-[1.125rem] font-medium md:text-[1.1875rem]">
            <span>{item.data.frage}</span>
            <span class="faq-icon relative mt-2 block size-3.5 shrink-0" aria-hidden="true"></span>
          </summary>
          <div class="pb-7 text-ink-600 measure">
            {item.data.platzhalter ? <Placeholder name={item.data.platzhalter} /> : <p>{item.data.antwort}</p>}
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: currentColor;
    transition: transform 300ms var(--ease-out-soft);
  }
  .faq-icon::after { transform: rotate(90deg); }
  .faq[open] .faq-icon::after { transform: rotate(0deg); }
</style>
