---
import { company } from '../../config/site';
---

<section class="section bg-water-800 text-stone-50" aria-labelledby="cta-title">
  <div class="container-page grid gap-y-10 md:grid-cols-12 md:items-end md:gap-x-6">
    <div class="md:col-span-7">
      <h2 id="cta-title" class="text-display max-w-[14ch]" data-reveal>Erzählen Sie uns von Ihrem Garten.</h2>
      <p class="mt-6 max-w-[44ch] text-lead text-water-200" data-reveal style="--reveal-delay: 80ms">
        Ein paar Angaben zu Ihrem Vorhaben genügen. Wir melden uns persönlich.
      </p>
    </div>
    <div class="flex flex-col gap-6 md:col-span-4 md:col-start-9" data-reveal style="--reveal-delay: 160ms">
      <a href="/anfrage" class="btn btn-light w-full sm:w-fit md:w-full">Projekt anfragen</a>
      <p class="text-small text-water-200">
        Oder rufen Sie an:
        <a href={company.phoneHref} class="link-underline mt-1 block w-fit font-display text-title text-stone-50 tabular-nums">{company.phone}</a>
      </p>
    </div>
  </div>
</section>
