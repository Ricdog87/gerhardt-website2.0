---
import Photo from '../Photo.astro';
import abend from '../../assets/images/cta/naturstein-pool-wiesbaden-abend-holzdeck.webp';
import { company } from '../../config/site';
---

<section class="cta grain relative isolate flex min-h-svh items-end overflow-hidden bg-ink-950 text-stone-50" data-scene="dark" data-parallax-frame aria-labelledby="cta-title">
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <Photo
      src={abend}
      alt=""
      widths={[768, 1080, 1440, 1920]}
      sizes="100vw"
      class="absolute inset-x-0 -top-[10%] h-[120%] w-full object-cover"
      style="object-position: 50% 55%"
      data-parallax="0.18"
    />
    <div class="cta-shade absolute inset-0"></div>
  </div>

  <div class="container-page grid w-full gap-y-12 pb-(--section) pt-[30vh] md:grid-cols-12 md:items-end md:gap-x-6">
    <div class="md:col-span-8">
      <p class="label text-sand-500" data-reveal>Ihr Projekt</p>
      <h2 id="cta-title" class="mt-6 text-cinema font-[300] max-w-[12ch]" data-split>Erzählen Sie uns von Ihrem Garten.</h2>
      <p class="mt-8 max-w-[44ch] text-lead text-stone-50/85" data-reveal>
        Ein paar Angaben zu Ihrem Vorhaben genügen. Wir melden uns persönlich.
      </p>
    </div>
    <div class="flex flex-col gap-6 md:col-span-4" data-reveal>
      <a href="/anfrage" class="btn btn-light w-full sm:w-fit md:w-full" data-magnetic>Projekt anfragen</a>
      <p class="text-small text-stone-50/75">
        Oder rufen Sie an:
        <a href={company.phoneHref} class="link-underline mt-1 block w-fit font-display text-title text-stone-50 tabular-nums">{company.phone}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta-shade {
    background:
      radial-gradient(120% 80% at 50% 30%, rgb(5 10 12 / 0.15) 0%, rgb(5 10 12 / 0.55) 100%),
      linear-gradient(to bottom, rgb(5 10 12 / 0.2) 0%, rgb(5 10 12 / 0.82) 100%);
  }
</style>
