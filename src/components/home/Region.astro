---
import { getCollection } from 'astro:content';
import SectionIntro from '../SectionIntro.astro';

const projekte = (await getCollection('projekte')).sort((a, b) => a.data.order - b.data.order);

const regions: { key: string; name: string; places: string[] }[] = [
  { key: 'wiesbaden', name: 'Wiesbaden', places: ['Sonnenberg', 'Nerotal', 'Rambach', 'Bierstadt'] },
  { key: 'taunus', name: 'Taunus', places: ['Königstein', 'Kronberg', 'Bad Homburg', 'Oberursel', 'Bad Soden', 'Kelkheim'] },
  { key: 'frankfurt', name: 'Frankfurt', places: ['Westend', 'Nordend', 'Sachsenhausen'] },
  { key: 'mainz', name: 'Mainz', places: [] },
];

const rowA = ['Wiesbaden', 'Sonnenberg', 'Nerotal', 'Königstein', 'Kronberg', 'Bad Homburg'];
const rowB = ['Frankfurt', 'Westend', 'Mainz', 'Oberursel', 'Bad Soden', 'Rambach'];
---

<section class="section overflow-hidden bg-stone-200" data-scene="sand" aria-labelledby="region-title">
  <div class="container-page">
    <SectionIntro titleId="region-title" label="Region" title="Von Wiesbaden aus im ganzen Rhein-Main-Gebiet.">
      <p>Unser Sitz ist Wiesbaden-Delkenheim. Von hier aus planen und bauen wir in Wiesbaden, im Taunus, in Frankfurt und in Mainz.</p>
    </SectionIntro>
  </div>

  <!-- Laufschrift, gekoppelt an die Scrollrichtung. Rein dekorativ, die Orte stehen unten als Liste. -->
  <div class="my-16 space-y-2 md:my-24" aria-hidden="true">
    {[rowA, rowB].map((row, r) => (
      <div class="marquee flex w-max whitespace-nowrap" data-marquee={r === 0 ? '-1' : '1'}>
        {[0, 1].map(() => (
          <span class="flex shrink-0 items-center font-display text-[clamp(3.5rem,1.5rem+8vw,10rem)] leading-[1.05] font-[250] tracking-[-0.03em]">
            {row.map((place, i) => (
              <>
                <span class:list={[i % 2 === 1 && 'text-transparent [-webkit-text-stroke:1px_var(--color-ink-900)]']}>{place}</span>
                <span class="mx-[0.35em] text-[0.4em] text-sand-700">●</span>
              </>
            ))}
          </span>
        ))}
      </div>
    ))}
  </div>

  <div class="container-page">
    <div class="grid gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-6">
      {regions.map((r, i) => {
        const here = projekte.filter((p) => p.data.region === r.key);
        return (
          <div class="border-t border-ink-900/20 pt-6" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <h3 class="text-title">{r.name}</h3>
            {r.places.length > 0 && <p class="mt-3 text-ink-600">{r.places.join(' · ')}</p>}
            {here.length > 0 && (
              <p class="mt-4 text-small">
                <span class="label mr-2 text-sand-700">Projekte</span>
                {here.map((p, j) => (
                  <>
                    <a href={`/projekte/${p.id}`} class="link-underline">{p.data.name}</a>
                    {j < here.length - 1 && ', '}
                  </>
                ))}
              </p>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { gsap, reduced, startMotion } from '../../scripts/motion';

  startMotion();

  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((row) => {
      const dir = Number(row.dataset.marquee);
      gsap.fromTo(
        row,
        { xPercent: dir < 0 ? 0 : -25 },
        {
          xPercent: dir < 0 ? -25 : 0,
          ease: 'none',
          scrollTrigger: { trigger: row, start: 'top bottom', end: 'bottom top', scrub: 0.6 },
        },
      );
    });
  }
</script>
