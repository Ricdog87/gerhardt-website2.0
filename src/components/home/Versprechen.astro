---
import Photo from '../Photo.astro';
import portrait from '../../assets/images/team/thomas-gerhardt-inhaber.webp';
import { company } from '../../config/site';
---

<section id="versprechen" class="section bg-water-800 text-stone-50" data-scene="dark" aria-labelledby="versprechen-title">
  <div class="container-page grid items-center gap-y-14 md:grid-cols-12 md:gap-x-6">
    <div class="md:col-span-5" data-reveal="image">
      <div class="relative aspect-[4/5] overflow-hidden" data-parallax-frame>
        <Photo
          src={portrait}
          alt="Thomas Gerhardt, Inhaber der Gerhardt GmbH, im Garten"
          widths={[480, 768, 1080]}
          sizes="(min-width: 1440px) 560px, (min-width: 768px) 40vw, 100vw"
          class="absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover"
          style="object-position: 50% 30%"
          data-parallax="0.14"
        />
      </div>
    </div>

    <figure class="md:col-span-6 md:col-start-7">
      <p class="label text-sand-500" data-reveal>Das Versprechen</p>
      <h2 id="versprechen-title" class="sr-only">Das Versprechen des Inhabers</h2>
      <blockquote class="mt-7">
        <p class="font-display text-[clamp(1.875rem,1.2rem+2.4vw,3.5rem)] leading-[1.14] font-[300] tracking-[-0.02em]" data-split>
          „Ich verspreche jedem Kunden vorher: Ich sehe das fertige Ergebnis vor mir — und es wird genau so, wie Sie es sich wünschen.“
        </p>
      </blockquote>
      <figcaption class="mt-10 border-t border-stone-50/20 pt-6" data-reveal>
        <span class="block font-medium">{company.owner}</span>
        <span class="block text-small text-water-200">Inhaber und Gründer</span>
        <span class="mt-5 block max-w-[46ch] text-small text-water-200">
          Thomas Gerhardt hat das Unternehmen {company.founded} gegründet. Seit {company.poolSince} baut die {company.name} Pools,
          mit eigenem Team und eigener Bauleitung.
        </span>
      </figcaption>
    </figure>
  </div>
</section>
