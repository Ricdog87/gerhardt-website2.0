---
// Einheitliche Bildausgabe: AVIF und WebP, JPEG als Fallback (statt PNG bei WebP-Quellen).
import { Picture } from 'astro:assets';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<typeof Picture>;
---

<Picture formats={['avif', 'webp']} fallbackFormat="jpg" {...Astro.props} />
