---
import Photo from './Photo.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projekte'>;
  /** CSS aspect-ratio, Standard 4:5 */
  ratio?: '4/5' | '3/2';
  sizes: string;
  delay?: number;
}

const { project, ratio = '4/5', sizes, delay = 0 } = Astro.props;
const p = project.data;
const typ = p.pool.typ === 'ueberlauf' ? 'Überlaufpool' : 'Skimmerpool';
---

<a href={`/projekte/${project.id}`} class="project-card group block" data-reveal style={`--reveal-delay: ${delay}ms`}>
  <div class="overflow-hidden bg-stone-200" style={`aspect-ratio: ${ratio}`}>
    <Photo
      src={p.cover}
      alt={p.coverAlt}
      widths={[480, 768, 1080, 1440]}
      sizes={sizes}
      class="h-full w-full object-cover transition-transform duration-[1200ms] ease-(--ease-out-soft) group-hover:scale-[1.03]"
      style={`object-position: ${p.coverPosition}`}
    />
  </div>
  <p class="label mt-5 text-ink-600">{p.ort} · {typ}</p>
  <h3 class="mt-2 text-title">
    <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_1px]">{p.name}</span>
  </h3>
  <p class="mt-2 text-small text-ink-600">
    <span>{p.pool.masse}</span>
    <span aria-hidden="true"> · </span>
    <span>{p.projektartLabel}</span>
    <span aria-hidden="true"> · </span>
    <span class="text-ink-900">{p.kostenLabel}</span>
  </p>
</a>
