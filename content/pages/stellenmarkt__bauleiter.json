  "blocks": [
    {
      "tag": "p",
      "cls": "page-head__eyebrow",
      "text": "Bauleitung · Vollzeit · Wiesbaden"
    },
    {
      "tag": "h1",
      "cls": "page-head__title",
      "text": "Junior Bauleiter (m/w/d)"
    },
    {
      "tag": "p",
      "cls": "page-head__lead",
      "text": "Aufmaß, Planung und Baustellensteuerung im Hausgarten- und Gewerbebereich."
    },
    {
      "tag": "p",
      "text": "Sie suchen eine neue Herausforderung, möchten sich verändern oder den nächsten Schritt auf der Karriereleiter gehen?"
    },
    {
      "tag": "p",
      "text": "Wir bieten Ihnen einen krisensicheren Arbeitsplatz in einer stetig wachsenden Branche. Auch in schwierigen Zeiten haben wir eine sehr hohe Auslastung. Für uns sind Motivation, Qualifikation und Kreativität die wichtigsten Bausteine für Erfolg und Wachstum."
    },
    {
      "tag": "p",
      "text": "Großen Wert legen wir auf langjährige, motivierte und eigene Mitarbeiter. Das Gerhardt‑Team ist über Jahre zusammengewachsen und lebt ein kollegiales Miteinander bis hin zur Geschäftsführung. Gegenseitiger Respekt und kurze Entscheidungswege sind aufgrund der flachen Organisationsstrukturen gegeben."
    },
    {
      "tag": "h2",
      "cls": "job__section-title",
      "text": "Ihre Aufgaben"
    },
    {
      "tag": "li",
      "text": "Aufmaß und Planung kleiner und mittlerer Bauvorhaben im Hausgartenbereich und gewerblichen Projekten"
    },
    {
      "tag": "li",
      "text": "Erstellen von Bewässerungsschemas (2D) nach Bedarf für laufende Bauvorhaben"
    },
    {
      "tag": "li",
      "text": "Fachliche Unterstützung der Bauleitung bei der kompletten Abwicklung der Bauvorhaben"
    },
    {
      "tag": "li",
      "text": "Fachliche Unterstützung bei Baustellendokumentation, Aufmaß-Erstellung, Materialdisposition, Abgleich der erbrachten Leistungen mit den beauftragten Leistungen, Ausführungsüberwachung"
    },
    {
      "tag": "li",
      "text": "Angebots- und Nachtragsbearbeitung"
    },
    {
      "tag": "li",
      "text": "Vorbereitung und Erstellen von abrechnungsfähigen Unterlagen"
    },
    {
      "tag": "li",
      "text": "Vertretung der Bauleitung bei Abwesenheit"
    },
    {
      "tag": "h2",
      "cls": "job__section-title",
      "text": "Anforderungen"
    },
    {
      "tag": "li",
      "text": "Abgeschlossene Ausbildung oder Techniker*in, Meister*in, Architekt*in, Bachelor*in"
    },
    {
      "tag": "li",
      "text": "Gute Kenntnisse in handwerklichen Abläufen"
    },
    {
      "tag": "li",
      "text": "Kreativität und planerisches Gespür"
    },
    {
      "tag": "li",
      "text": "Gepflegtes und freundliches Auftreten"
    },
    {
      "tag": "li",
      "text": "Wenn möglich, CAD-Kenntnisse (AutoCAD)"
    },
    {
      "tag": "li",
      "text": "Gute PC-Kenntnisse (Outlook, Word, Excel und PowerPoint)"
    },
    {
      "tag": "li",
      "text": "Teamfähigkeit"
    },
    {
      "tag": "li",
      "text": "Führerschein Klasse B"
    },
    {
      "tag": "li",
      "text": "Sehr gute Deutschkenntnisse"
    },
    {
      "tag": "li",
      "text": "Eigenverantwortliches Handeln"
    },
    {
      "tag": "li",
      "text": "Offenheit und Neugierde gegenüber neuen Aufgaben und Herausforderungen"
    },
    {
      "tag": "li",
      "text": "Problemlösungskompetenz und Detailgenauigkeit sowie proaktive Herangehensweise, Eigeninitiative und Engagement"
    },
    {
      "tag": "li",
      "text": "Professionelle Kommunikation auf den Kontaktkanälen Telefon, E-Mail sowie im direkten Kundenkontakt"
    },
    {
      "tag": "li",
      "text": "Hervorragende Zeitmanagement- und Multitasking-Fähigkeiten mit der Fähigkeit zur Priorisierung"
    },
    {
      "tag": "li",
      "text": "Hohe Belastbarkeit, Organisationsgeschick"
    },
    {
      "tag": "h2",
      "cls": "job__section-title",
      "text": "Was wir bieten"
    },
    {
      "tag": "li",
      "text": "Leistungsgerechte und gesicherte Vergütung"
    },
    {
      "tag": "li",
      "text": "Krisensicherer Vollzeitarbeitsplatz"
    },
    {
      "tag": "li",
      "text": "Unbefristeter Arbeitsvertrag"
    },
    {
      "tag": "li",
      "text": "Weiterbildungsmöglichkeiten"
    },
    {
      "tag": "li",
      "text": "Spannende Projekte"
    },
    {
      "tag": "li",
      "text": "Lockere Arbeitsatmosphäre"
    },
    {
      "tag": "li",
      "text": "Hohes Maß an eigener Verantwortung"
    },
    {
      "tag": "li",
      "text": "Abwechslungsreiche Tätigkeit in familiärer Atmosphäre"
    },
    {
      "tag": "li",
      "text": "Teamgeist und ein optimales Umfeld für Ihren nächsten Karriereschritt"
    },
    {
      "tag": "li",
      "text": "Langfristige Zusammenarbeit"
    },
    {
      "tag": "li",
      "text": "Betriebliche Altersvorsorge"
    },
    {
      "tag": "p",
      "text": "Wir freuen uns auf Ihre Bewerbung. Bei weiteren Fragen steht Ihnen Frau Müller unter 06122 7077005 oder per E‑Mail an info@gerhardt-gmbh.de gerne zur Verfügung."
    },
