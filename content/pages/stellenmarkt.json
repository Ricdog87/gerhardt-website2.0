  "blocks": [
    {
      "tag": "p",
      "cls": "page-head__eyebrow",
      "text": "Stellenmarkt · Wiesbaden"
    },
    {
      "tag": "h1",
      "cls": "page-head__title",
      "text": "Sie finden das, was wir tun, genauso spannend wie wir?"
    },
    {
      "tag": "p",
      "cls": "page-head__lead",
      "text": "Wir suchen für unseren Standort in Wiesbaden zum nächstmöglichen Eintritt eine/n:"
    },
    {
      "tag": "h2",
      "cls": "job-card__title",
      "text": "Kaufm. Mitarbeiter Backoffice (m/w/d)"
    },
    {
      "tag": "p",
      "cls": "job-card__hook",
      "text": "Korrespondenz, Kundenanfragen, Fakturierung — im Zentrum unseres Tagesgeschäfts."
    },
    {
      "tag": "h2",
      "cls": "job-card__title",
      "text": "Servicetechniker / Kundendiensttechniker (m/w/d)"
    },
    {
      "tag": "p",
      "cls": "job-card__hook",
      "text": "Wartung, Reparatur und Inbetriebnahme wassertechnischer Anlagen direkt beim Kunden."
    },
    {
      "tag": "h2",
      "cls": "job-card__title",
      "text": "Monteur für wassertechnische Anlagen (m/w/d) — Fachrichtung Elektro"
    },
    {
      "tag": "p",
      "cls": "job-card__hook",
      "text": "Verkabelung, Steuerungen, Inbetriebnahme — für Pools, Brunnen und Bewässerung."
    },
    {
      "tag": "h2",
      "cls": "job-card__title",
      "text": "Monteur für wassertechnische Anlagen (m/w/d) — Fachrichtung Installation"
    },
    {
      "tag": "p",
      "cls": "job-card__hook",
      "text": "Rohrleitungsbau, Druckprüfung, Montage — für Bewässerung, Brunnen und Pools."
    },
    {
      "tag": "h2",
      "cls": "job-card__title",
      "text": "Monteur für wassertechnische Anlagen (m/w/d) — Fachrichtung Schwimmbadbau"
    },
    {
      "tag": "p",
      "cls": "job-card__hook",
      "text": "Beckenmontage, Poolabdeckung, Wärmepumpen — vom Rohbau bis zur Inbetriebnahme."
    },
    {
      "tag": "h2",
      "cls": "job-card__title",
      "text": "Monteur für wassertechnische Anlagen (m/w/d)"
    },
    {
      "tag": "p",
      "cls": "job-card__hook",
      "text": "Installation von Beregnungsanlagen, Brunnen und Pools — für Gewerbe und Privat."
    },
    {
      "tag": "h2",
      "cls": "job-card__title",
      "text": "Junior Bauleiter (m/w/d)"
    },
    {
      "tag": "p",
      "cls": "job-card__hook",
      "text": "Aufmaß, Planung und Baustellensteuerung im Hausgarten- und Gewerbebereich."
    },
    {
      "tag": "h2",
      "cls": "job-card__title",
      "text": "Nichts Passendes dabei?"
    },
    {
      "tag": "p",
      "cls": "job-card__hook",
      "text": "Wir freuen uns trotzdem über Ihre Bewerbung. Kurz erzählen, wo Sie sich bei uns sehen — den Rest klären wir gemeinsam."
    },
    {
      "tag": "h2",
      "cls": "contact-strip__title",
      "text": "Fragen zu einer Stelle?"
    },
    {
      "tag": "p",
      "cls": "contact-strip__body",
      "text": "Rufen Sie an oder schreiben Sie eine E-Mail. Wir melden uns persönlich zurück."
    },
    {
      "tag": "p",
      "cls": "contact-person__eyebrow",
      "text": "Ansprechpartnerin"
    },
    {
      "tag": "p",
      "cls": "contact-person__name",
      "text": "Frau Müller"
    },
