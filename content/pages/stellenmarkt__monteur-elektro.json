  "blocks": [
    {
      "tag": "p",
      "cls": "page-head__eyebrow",
      "text": "Handwerk · Vollzeit · Rhein-Main-Gebiet"
    },
    {
      "tag": "h1",
      "cls": "page-head__title",
      "text": "Monteur für wassertechnische Anlagen (m/w/d) — Fachrichtung Elektro"
    },
    {
      "tag": "p",
      "cls": "page-head__lead",
      "text": "Verkabelung, Steuerungen, Inbetriebnahme — für Pools, Brunnen und Bewässerung."
    },
    {
      "tag": "p",
      "text": "Sie suchen eine neue Herausforderung, möchten sich verändern oder den nächsten Schritt auf der Karriereleiter gehen?"
    },
    {
      "tag": "p",
      "text": "Wir bieten Ihnen einen krisensicheren Arbeitsplatz in einer stetig wachsenden Branche. Auch in schwierigen Zeiten haben wir eine sehr hohe Auslastung. Für uns sind Motivation, Qualifikation und Kreativität die wichtigsten Bausteine für Erfolg und Wachstum."
    },
    {
      "tag": "p",
      "text": "Großen Wert legen wir auf langjährige, motivierte und eigene Mitarbeiter. Das Gerhardt‑Team ist über Jahre zusammengewachsen und lebt ein kollegiales Miteinander bis hin zur Geschäftsführung. Gegenseitiger Respekt und kurze Entscheidungswege sind aufgrund der flachen Organisationsstrukturen gegeben."
    },
    {
      "tag": "h2",
      "cls": "job__section-title",
      "text": "Ihre Aufgaben"
    },
    {
      "tag": "li",
      "text": "Installation von wassertechnischen Anlagen wie öffentliche Brunnenanlagen und private Pools sowie Beregnungsanlagen auf gewerblichen und privaten Grünanlagen"
    },
    {
      "tag": "li",
      "text": "Installation, Konfiguration und Inbetriebnahme der entsprechenden Anlagen"
    },
    {
      "tag": "li",
      "text": "Installation, Verkabelung und Sicherstellung der Funktionalität verschiedener elektrischer Systeme"
    },
    {
      "tag": "li",
      "text": "Lesen und Verstehen von Zeichnungen sowie Schalt- und Bauplänen und Entwicklung eigener Strategien zur Problemlösung"
    },
    {
      "tag": "li",
      "text": "Installation von Verteiler- und Sicherheitskomponenten"
    },
    {
      "tag": "li",
      "text": "Identifikation, Reparatur oder Austausch beschädigter Kabel, Geräte oder Komponenten"
    },
    {
      "tag": "li",
      "text": "Regelmäßige Prüfung komplexer Verkabelungen und Schaltkreise auf Funktionalität"
    },
    {
      "tag": "li",
      "text": "Ausfüllen von Bautagesberichten"
    },
    {
      "tag": "li",
      "text": "Abwechslungsreiche Aufgaben in einem motivierten Team"
    },
    {
      "tag": "h2",
      "cls": "job__section-title",
      "text": "Anforderungen"
    },
    {
      "tag": "li",
      "text": "Abgeschlossene Ausbildung als Elektriker, Elektroniker, Elektrotechniker oder vergleichbare Qualifikation inkl. Zulassung zur Ausübung Ihres Berufs"
    },
    {
      "tag": "li",
      "text": "Erfahrung im Umgang mit kommerziellen und industriellen elektrischen Systemen"
    },
    {
      "tag": "li",
      "text": "Sicheres Analysieren und Lesen von Schaltplänen, Zeichnungen und Bauplänen"
    },
    {
      "tag": "li",
      "text": "Handwerkliche Kenntnisse und ein technisches Verständnis"
    },
    {
      "tag": "li",
      "text": "Gute Deutschkenntnisse in Wort und Schrift"
    },
    {
      "tag": "li",
      "text": "Führerschein Klasse B (oder mehr)"
    },
    {
      "tag": "li",
      "text": "Nachweisbare Fähigkeit zur Verwendung von Elektrowerkzeugen und notwendigen Handwerksmaterialien"
    },
    {
      "tag": "li",
      "text": "Kundenorientierte, selbständige und eigenverantwortliche Arbeitsweise"
    },
    {
      "tag": "li",
      "text": "Körperliche Belastbarkeit und ausgeprägte Fähigkeit zur Problemlösung"
    },
    {
      "tag": "li",
      "text": "Flexible, analytische und sicherheitsorientierte Denkweise"
    },
    {
      "tag": "li",
      "text": "Stressresistenz und Freude an Teamarbeit"
    },
    {
      "tag": "li",
      "text": "Offener, freundlicher Umgang mit Kollegen und Kunden"
    },
    {
      "tag": "h2",
      "cls": "job__section-title",
      "text": "Was wir bieten"
    },
    {
      "tag": "li",
      "text": "Leistungsgerechte und gesicherte Vergütung"
    },
    {
      "tag": "li",
      "text": "Unbefristeter Arbeitsvertrag mit abwechslungsreichen Tätigkeiten"
    },
    {
      "tag": "li",
      "text": "Betriebliche Altersvorsorge"
    },
    {
      "tag": "li",
      "text": "Intensive Einarbeitung und regelmäßige Schulungen"
    },
    {
      "tag": "li",
      "text": "Kostenlose Bereitstellung von Arbeitskleidung und Markenwerkzeug"
    },
    {
      "tag": "li",
      "text": "Wohnortnaher Einsatz im Rhein‑Main‑Gebiet"
    },
    {
      "tag": "li",
      "text": "Auch Berufsanfänger sind willkommen"
    },
    {
      "tag": "p",
      "text": "Wir freuen uns auf Ihre Bewerbung. Bei weiteren Fragen steht Ihnen Frau Müller unter 06122 7077005 oder per E‑Mail an info@gerhardt-gmbh.de gerne zur Verfügung."
    },
