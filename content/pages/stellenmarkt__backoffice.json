    },
    {
      "tag": "li",
      "text": "in etwa 4 Wochen"
    },
    {
      "tag": "li",
      "text": "innerhalb von 3 Monaten"
    },
    {
      "tag": "li",
      "text": "frühestens in 3 Monaten"
    },
    {
      "tag": "p",
      "cls": "apply__privacy",
      "text": "Mit dem Absenden verarbeiten wir Ihre Angaben, um Ihre Bewerbung zu bearbeiten. Einzelheiten finden Sie in unserer Datenschutzerklärung."
    },
