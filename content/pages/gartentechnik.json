  "blocks": [
    {
      "tag": "h1",
      "cls": "hero__title",
      "text": "Alles, was den Garten leichter macht."
    },
    {
      "tag": "p",
      "cls": "hero__sub",
      "text": "Bewässerung, Beleuchtung, Rasenroboter und Wartung — geplant, gebaut und gepflegt von einem Team im Rhein‑Main‑Gebiet."
    },
    {
      "tag": "p",
      "cls": "intro__text",
      "text": "Rasenmähen und Gießen sind die zwei zeitaufwendigsten Arbeiten im Garten. Beide lassen sich automatisieren. Und mit Licht und Wasser wird aus einem Garten, den man pflegt, einer, in dem man Zeit verbringt."
    },
    {
      "tag": "h2",
      "cls": "tile__name",
      "text": "Bewässerung"
    },
    {
      "tag": "p",
      "cls": "tile__pitch",
      "text": "Fest installiert, wetterabhängig gesteuert, per App. Auch im Bestand ohne Spuren."
    },
    {
      "tag": "h2",
      "cls": "tile__name",
      "text": "Beleuchtung"
    },
    {
      "tag": "p",
      "cls": "tile__pitch",
      "text": "Räume, die es tagsüber nicht gibt. Modular, wachsend, im Bestand ohne bleibende Spuren."
    },
    {
      "tag": "h2",
      "cls": "tile__name",
      "text": "Rasenroboter"
    },
    {
      "tag": "p",
      "cls": "tile__pitch",
      "text": "Fachhändler für Husqvarna und Kress. Vor Ort eingerichtet, ganzjährig betreut."
    },
    {
      "tag": "h2",
      "cls": "tile__name",
      "text": "Wartung & Service"
    },
    {
      "tag": "p",
      "cls": "tile__pitch",
      "text": "Frühjahrs‑Check, Einwinterung, Pflege. Auch für Anlagen von anderen."
    },
    {
      "tag": "h2",
      "cls": "contact__title",
      "text": "Erzählen Sie uns von Ihrem Projekt."
    },
    {
      "tag": "p",
      "cls": "contact__intro",
      "text": "Ein paar Angaben zu Ihrem Vorhaben — wir melden uns persönlich."
    },
    {
      "tag": "li",
